# ============================================================================
# PDFly — Root .gitignore (Android + Official Website + Secret Protection)
# ============================================================================

# Gradle & Android Build Outputs
.gradle/
build/
app/build/
.kotlin/
.build-outputs/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
output-metadata.json

# Local Environment & Secrets (NEVER COMMIT)
local.properties
.env
.env.local
.env.*.local
google-services.json

# Keystores & Signing Credentials (NEVER COMMIT)
*.jks
*.keystore
debug.keystore
debug.keystore.base64

# Website Dependencies & Static Build Artifacts
website/node_modules/
website/dist/
website/.vite/
*.tsbuildinfo
.npm/

# Android Studio / IntelliJ IDEA / OS
*.iml
.idea/
.DS_Store
Thumbs.db
*.log
*.hprof
